# ==============================================================================
# AI-POWERED DCF VALUATION AND SENSITIVITY ENGINE - ENVIRONMENT CONFIGURATION
# ==============================================================================
# Copy this file to .env and configure local settings as needed.
# DO NOT commit real secrets, private keys, or passwords to version control.
# ==============================================================================

# Application Environment Mode: development | staging | production
APP_ENV=development

# Debug Mode: True | False
APP_DEBUG=True

# Application Server Host and Port
APP_HOST=localhost
APP_PORT=8501

# Logging Level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Database Connection URL (SQLite foundation for local projects)
DATABASE_URL=sqlite:///database/dcf_engine.db

# Storage Directories (relative to project root, or absolute paths)
DATA_DIR=data
DATABASE_DIR=database
DOCS_DIR=docs
